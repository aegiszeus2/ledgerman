# Never cache index.html — ensures users always get the latest version with correct JS version strings
/index.html
  Cache-Control: no-store, no-cache, must-revalidate

# Never cache config.js — contains API URL which can change
/config.js
  Cache-Control: no-store, no-cache, must-revalidate

# Versioned assets can be cached aggressively (version string changes on each deploy)
/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable
